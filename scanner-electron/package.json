{
  "name": "scanner-electron",
  "version": "1.0.0",
  "description": "Local Electron scanner app for NAPS2 PDF scanning.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "pack": "electron-builder --dir"
  },
  "keywords": [
    "electron",
    "scanner",
    "naps2"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "^41.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "productName": "Roses Scanner Agent",
    "appId": "com.roses.scanner.agent",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "package.json",
      "build/icon.ico"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Roses Scanner Agent",
      "artifactName": "Roses-Scanner-Agent-Setup-${version}.${ext}",
      "runAfterFinish": true
    }
  }
}
